# ==================================================
# ENVIRONMENT VARIABLES - COOPERATIVE GIG PLATFORM
# ==================================================

# Supabase Client Configuration (Public / Browser Accessible)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Server-Only Secrets (DO NOT EXPOSE TO CLIENT CODE)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Maps API Configuration (Public / Browser Accessible)
NEXT_PUBLIC_MAP_API_KEY=your-map-api-key-here

# Payment Gateway Configuration (Razorpay - Server-Only Secrets)
RAZORPAY_KEY_ID=your-razorpay-key-id-here
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-here
